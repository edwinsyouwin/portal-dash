<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The dashboard's voice calls to Muse use the microphone (voice.js). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- For the dashboard's "USB debugging" setting. Android only gives this to apps it is
         granted to over adb (scripts/install.sh); without it the setting opens Settings. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- The dashboard's snapshot button (snapshot.js). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Lends the Bluetooth radio to the Mac while it pairs with the Muse app (BleRelay). -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />

    <!-- Cleartext is allowed so the shell can load a dashboard from a LAN or adb-reverse dev server. -->
    <application
        android:icon="@drawable/ic_launcher"
        android:label="Portal Dash"
        android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Home-screen entry point. Disabled by default so installing the app never
            touches the Portal's launcher. MainActivity enables it on request (see
            applyHomeExtra and the "Home screen" commands in the README).
        -->
        <activity-alias
            android:name=".Home"
            android:enabled="false"
            android:exported="true"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
