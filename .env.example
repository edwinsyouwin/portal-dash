# Copy to .env and fill in. Never commit .env.

# Image provider keys: only the one named by `provider` in photoflow/profile.toml is needed.
OPENAI_API_KEY=
GEMINI_API_KEY=

# Google Calendar: one line per calendar, CALENDAR_<NAME>=<secret iCal address>.
# <NAME> becomes the label on that person's events. Find the address in Google Calendar
# under Settings > your calendar > "Secret address in iCal format".
CALENDAR_ALEX=
CALENDAR_SAM=
